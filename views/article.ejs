<%- include('partials/header', { title: article.title }) %>
<%- include('partials/navbar') %>

<div class="container premium-article-layout mt-5"
     id="articleContainer"
     data-article-id="<%= article._id.toString() %>"
     data-user-id="<%= (typeof user !== 'undefined' && user) ? user._id.toString() : '' %>">

    <div class="row">
        <div class="col-xl-8 col-lg-9 mx-auto">

            <div class="article-header-block mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge-premium-category">News</span>
                    <span class="article-source-node">
                        <i class="fa-solid fa-newspaper text-primary me-1"></i> <strong><%= article.source?.name || 'Unknown Source' %></strong>
                    </span>
                </div>

                <h1 class="premium-article-title mb-4"><%= article.title %></h1>

                <div class="article-author-meta d-flex flex-wrap align-items-center justify-content-between gap-3 pb-4 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <div class="author-name-text"><%= article.author || 'Editorial Staff' %></div>
                            <% if (article.publishedAt) { %>
                                <div class="author-date-text">
                                    <i class="fa-regular fa-calendar me-1"></i> <%= new Date(article.publishedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div style="display: flex; align-items: center; gap: 4px;">
                        <button id="copy-link-btn" class="copy-link-btn" onclick="copyArticleLink()">
                            <i class="fa-solid fa-link"></i>
                            <span class="copy-tooltip">Copied!</span>
                        </button>

                        <% if (typeof user !== 'undefined' && user) { %>
                            <button class="btn p-0 fav-toggle-btn" data-id="<%= article._id.toString() %>" style="background: none; border: none; outline: none; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; transition: all 0.2s ease;">
                                <% const isFav = user.favorites && user.favorites.map(f => f.toString()).includes(article._id.toString()); %>
                                <i class="<%= isFav ? 'fa-solid' : 'fa-regular' %> fa-star" style="color: <%= isFav ? '#ffc107' : '#94a3b8' %>; font-size: 1.5rem; transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.2s ease;"></i>
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="premium-article-media mb-5">
                <img src="<%= article.urlToImage || 'https://placehold.co/1200x600?text=No+Image+Available' %>"
                     onerror="this.onerror=null; this.src='https://placehold.co/1200x600?text=No+Image+Available';"
                     class="img-fluid modern-hero-media"
                     alt="<%= article.title %>">
            </div>

            <div class="premium-article-body">
                <% if (article.description) { %>
                    <p class="premium-lead-excerpt mb-4"><%= article.description %></p>
                <% } %>

                <div class="premium-full-content mb-5">
                    <%= (article.content || '').replace(/<[^>]+>/g, '') %>
                </div>
            </div>

            <div class="premium-article-footer d-flex flex-wrap align-items-center justify-content-between gap-4 pt-4 border-top mb-5">

                <div class="reactions-inline-zone">
                    <div class="reaction-trigger-zone">
                        <button class="btn btn-light main-react-btn <%= activeType ? 'active-react' : '' %>" id="mainReactBtn" type="button" style="user-select: none; -webkit-user-select: none; <%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                            <% if (activeType === 'like') { %>
                                <i class="fa-solid fa-thumbs-up text-primary custom-react-icon animate-pop"></i> <span class="main-btn-text text-primary">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } else if (activeType === 'funny') { %>
                                😂 <span class="main-btn-text text-warning">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } else if (activeType === 'sad') { %>
                                😢 <span class="main-btn-text text-warning">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } else if (activeType === 'wow') { %>
                                😮 <span class="main-btn-text text-warning">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } else if (activeType === 'angry') { %>
                                😡 <span class="main-btn-text text-danger">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } else { %>
                                <i class="fa-regular fa-thumbs-up custom-react-icon"></i> <span class="main-btn-text">Reactions (<span id="main-total-counter"><%= totalReactsCount %></span>)</span>
                            <% } %>
                        </button>

                        <div class="emojis-popup-panel" id="emojisPanel">
                            <button class="emoji-option-btn <%= activeType === 'like' ? 'selected' : '' %>" data-type="like" title="Like" style="<%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                                <span class="emoji-img">👍</span>
                                <span class="emoji-counter" id="count-like"><%= reacts.like.length %></span>
                            </button>

                            <button class="emoji-option-btn <%= activeType === 'funny' ? 'selected' : '' %>" data-type="funny" title="Haha" style="<%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                                <span class="emoji-img">😂</span>
                                <span class="emoji-counter" id="count-funny"><%= reacts.funny.length %></span>
                            </button>

                            <button class="emoji-option-btn <%= activeType === 'sad' ? 'selected' : '' %>" data-type="sad" title="Sad" style="<%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                                <span class="emoji-img">😢</span>
                                <span class="emoji-counter" id="count-sad"><%= reacts.sad.length %></span>
                            </button>

                            <button class="emoji-option-btn <%= activeType === 'wow' ? 'selected' : '' %>" data-type="wow" title="Wow" style="<%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                                <span class="emoji-img">😮</span>
                                <span class="emoji-counter" id="count-wow"><%= reacts.wow.length %></span>
                            </button>

                            <button class="emoji-option-btn <%= activeType === 'angry' ? 'selected' : '' %>" data-type="angry" title="Angry" style="<%= !(typeof user !== 'undefined' && user) ? 'cursor: not-allowed;' : '' %>">
                                <span class="emoji-img">😡</span>
                                <span class="emoji-counter" id="count-angry"><%= reacts.angry.length %></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="action-buttons-zone d-flex gap-3">
                    <a href="<%= article.url %>" target="_blank" class="btn btn-premium-action-dark m-0">
                        View Original Source <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
                    </a>
                    <a href="/news/<%= article._id %>/analyze" class="btn btn-premium-action-blue m-0">
                        <i class="fa-solid fa-robot me-2"></i> Analyze with AI
                    </a>
                </div>

            </div>

            <div class="comments-wrapper">
                <% const validCommentsCount = comments ? comments.filter(c => c.user).length : 0; %>
                <h3 class="mb-4" style="font-weight: 800; color: #0f172a;">
                    Discussion (<%= validCommentsCount %>)
                </h3>

                <div class="comments-list mb-4">
                    <% if (typeof comments !== 'undefined' && comments.length > 0) { %>
                        <% comments.forEach(comment => { %>
                            <% if (comment.user) { %>
                                <div class="comment-box d-flex gap-3" id="comment-<%= comment._id %>">
                                    <a href="/auth/profile/<%= comment.user._id %>">
                                        <img src="<%= comment.user.profileImage || '/uploads/default-avatar.png' %>" alt="<%= comment.user.username %>" class="comment-avatar" style="cursor: pointer;">
                                    </a>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="comment-author">
                                                <a href="/auth/profile/<%= comment.user._id %>" style="text-decoration: none; color: inherit; font-weight: 700;">
                                                    <%= comment.user.username %>
                                                </a>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="comment-date"><%= new Date(comment.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                                                <% if (typeof user !== 'undefined' && user && comment.user._id.toString() === user._id.toString()) { %>
                                                    <form action="/news/<%= article._id %>/comment/<%= comment._id %>/delete" method="POST" class="delete-comment-form">
                                                        <button type="submit" class="btn btn-link text-danger p-0">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="comment-text"><%= comment.text %></div>
                                    </div>
                                </div>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center text-muted py-5 mb-4">
                            <i class="fa-regular fa-comment-dots fa-3x mb-3 opacity-25"></i>
                            <p>No comments yet. Be the first to share your thoughts!</p>
                        </div>
                    <% } %>
                </div>

                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <nav class="d-flex justify-content-center gap-2 mb-4">
                        <% if (currentPage > 1) { %>
                            <a href="/news/<%= article._id %>?commentPage=<%= currentPage - 1 %>" class="btn btn-sm btn-outline-primary">Previous</a>
                        <% } %>
                        <span class="align-self-center">Page <%= currentPage %> of <%= totalPages %></span>
                        <% if (currentPage < totalPages) { %>
                            <a href="/news/<%= article._id %>?commentPage=<%= parseInt(currentPage) + 1 %>" class="btn btn-sm btn-outline-primary">Next</a>
                        <% } %>
                    </nav>
                <% } %>

                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="comment-input-area mt-4">
                        <form action="/news/<%= article._id %>/comment" method="POST" class="add-comment-form">
                            <div class="d-flex gap-3">
                                <img src="<%= user.profileImage || '/uploads/default-avatar.png' %>" alt="Your Avatar" class="comment-avatar">
                                <div class="flex-grow-1">
                                    <textarea name="text" class="custom-textarea mb-3" placeholder="Share your thoughts about this article..." required></textarea>
                                    <div class="text-end">
                                        <button type="submit" class="btn-submit-comment">
                                            Post Comment <i class="fa-solid fa-paper-plane ms-1"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                <% } else { %>
                    <div class="auth-prompt mb-5 mt-4">
                        <i class="fa-regular fa-comments fa-3x mb-3 text-primary opacity-50"></i>
                        <h5>Join the Conversation</h5>
                        <p class="text-muted">You need to be logged in to leave a comment.</p>
                        <a href="/auth/login" class="btn btn-primary px-4 py-2" style="border-radius: 12px; font-weight: 600;">Sign In</a>
                        <a href="/auth/register" class="btn btn-outline-primary px-4 py-2 ms-2" style="border-radius: 12px; font-weight: 600;">Create Account</a>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<script>
    function copyArticleLink() {
        const url = window.location.href;
        const btn = document.getElementById('copy-link-btn');

        navigator.clipboard.writeText(url).then(() => {
            btn.classList.add('copied');
            setTimeout(() => btn.classList.remove('copied'), 2000);
        }).catch(() => {
            const textarea = document.createElement('textarea');
            textarea.value = url;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            btn.classList.add('copied');
            setTimeout(() => btn.classList.remove('copied'), 2000);
        });
    }
</script>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('articleContainer');
        const articleId = container.dataset.articleId;
        const currentUserId = container.dataset.userId;

        const favBtn = document.querySelector('.fav-toggle-btn');
        if (favBtn) {
            favBtn.addEventListener('click', async () => {
                const id = favBtn.dataset.id;
                const icon = favBtn.querySelector('i');
                try {
                    const response = await fetch(`/auth/favorites/toggle/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        icon.className = data.isAdded ? 'fa-solid fa-star' : 'fa-regular fa-star';
                        icon.style.color = data.isAdded ? '#ffc107' : '#94a3b8';
                    }
                } catch (err) { console.error(err); }
            });
        }

        let socket;

        function connectSocket() {
            if (socket && socket.connected) return;

            socket = io();
            socket.emit('join_article', articleId);

            socket.on('update_reactions', (data) => {
                if(document.getElementById('count-like')) document.getElementById('count-like').innerText = data.likeCount;
                if(document.getElementById('count-funny')) document.getElementById('count-funny').innerText = data.funnyCount || 0;
                if(document.getElementById('count-sad')) document.getElementById('count-sad').innerText = data.sadCount;
                if(document.getElementById('count-wow')) document.getElementById('count-wow').innerText = data.wowCount;
                if(document.getElementById('count-angry')) document.getElementById('count-angry').innerText = data.angryCount;

                const total = data.likeCount + (data.funnyCount || 0) + data.sadCount + data.wowCount + data.angryCount;
                const counterSpan = document.getElementById('main-total-counter');
                if (counterSpan) counterSpan.innerText = total;
            });

            socket.on('new_comment', (data) => {
                const commentsList = document.querySelector('.comments-list');
                const emptyState = commentsList.querySelector('.text-center.text-muted');
                if (emptyState) emptyState.remove();

                const showDeleteButton = currentUserId && data.userId && data.userId.toString() === currentUserId;

                const commentHtml = `
                    <div class="comment-box d-flex gap-3" id="comment-${data.commentId || ''}" style="opacity: 0; transform: translateX(-20px); transition: all 0.4s ease;">
                        <a href="/auth/profile/${data.user._id}">
                            <img src="${data.user.profileImage || '/uploads/default-avatar.png'}" alt="${data.user.username}" class="comment-avatar" style="cursor: pointer;">
                        </a>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="comment-author">
                                    <a href="/auth/profile/${data.user._id}" style="text-decoration: none; color: inherit; font-weight: 700;">
                                        ${data.user.username}
                                    </a>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="comment-date">${new Date(data.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</div>
                                    ${showDeleteButton ? `
                                        <form action="/news/${articleId}/comment/${data.commentId}/delete" method="POST" class="delete-comment-form">
                                            <button type="submit" class="btn btn-link text-danger p-0">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    ` : ''}
                                </div>
                            </div>
                            <div class="comment-text">${data.text}</div>
                        </div>
                    </div>
                `;

                commentsList.insertAdjacentHTML('beforeend', commentHtml);

                setTimeout(() => {
                    const lastComment = commentsList.lastElementChild;
                    if (lastComment) {
                        lastComment.style.opacity = '1';
                        lastComment.style.transform = 'translateX(0)';
                    }
                }, 500);

                const titleElement = document.querySelector('.comments-wrapper h3');
                if (titleElement) {
                    const match = titleElement.innerText.match(/\((\d+)\)/);
                    if (match) {
                        const currentCount = parseInt(match[1]) + 1;
                        titleElement.innerHTML = `Discussion (${currentCount})`;
                    }
                }
            });

            socket.on('delete_comment', (data) => {
                const commentElement = document.getElementById(`comment-${data.commentId}`);
                const commentsList = document.querySelector('.comments-list');

                if (commentElement) {
                    commentElement.style.opacity = '0';
                    commentElement.style.transform = 'translateX(20px)';
                    commentElement.style.transition = 'all 0.4s ease';

                    setTimeout(() => {
                        commentElement.remove();

                        const remainingComments = commentsList.querySelectorAll('.comment-box');
                        if (remainingComments.length === 0) {
                            const emptyHtml = `
                                <div class="text-center text-muted py-5 mb-4" style="opacity: 0; transition: opacity 0.4s ease;">
                                    <i class="fa-regular fa-comment-dots fa-3x mb-3 opacity-25"></i>
                                    <p>No comments yet. Be the first to share your thoughts!</p>
                                </div>
                            `;
                            commentsList.innerHTML = emptyHtml;

                            setTimeout(() => {
                                const emptyBlock = commentsList.querySelector('.text-center.text-muted');
                                if (emptyBlock) emptyBlock.style.opacity = '1';
                            }, 50);
                        }
                    }, 400);
                }

                const titleElement = document.querySelector('.comments-wrapper h3');
                if (titleElement) {
                    const match = titleElement.innerText.match(/\((\d+)\)/);
                    if (match) {
                        const currentCount = Math.max(0, parseInt(match[1]) - 1);
                        titleElement.innerHTML = `Discussion (${currentCount})`;
                    }
                }
            });
        }

        window.addEventListener('pageshow', (event) => {
            if (event.persisted) {
                window.location.reload();
            } else {
                connectSocket();
            }
        });

        const mainReactBtn = document.getElementById('mainReactBtn');
        const emojisPanel = document.getElementById('emojisPanel');
        const triggerZone = document.querySelector('.reaction-trigger-zone');

        let enterTimeout;
        let leaveTimeout;
        let touchTimeout;
        let isLongPress = false;

        async function sendReactionRequest(reactionType) {
            if (!currentUserId) return;

            try {
                const response = await fetch(`/news/${articleId}/react`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reactionType })
                });

                const data = await response.json();
                if (!data.success) return;

                clearTimeout(leaveTimeout);
                emojisPanel.classList.remove('show-panel');
                document.querySelectorAll('.emoji-option-btn').forEach(b => b.classList.remove('selected'));

                if (data.isAdded) {
                    const activeBtn = document.querySelector(`.emoji-option-btn[data-type="${reactionType}"]`);
                    if (activeBtn) activeBtn.classList.add('selected');
                    mainReactBtn.classList.add('active-react');

                    let textClass = 'text-warning';
                    if (reactionType === 'like') textClass = 'text-primary';
                    if (reactionType === 'angry') textClass = 'text-danger';

                    updateMainButtonUI(reactionType, textClass);
                } else {
                    mainReactBtn.classList.remove('active-react');
                    const total = document.getElementById('main-total-counter') ? document.getElementById('main-total-counter').innerText : '0';
                    mainReactBtn.innerHTML = `<i class="fa-regular fa-thumbs-up custom-react-icon"></i> <span class="main-btn-text">Reactions (<span id="main-total-counter">${total}</span>)</span>`;
                }
            } catch (err) { console.error(err); }
        }

        function updateMainButtonUI(type, textClass) {
            const total = document.getElementById('main-total-counter') ? document.getElementById('main-total-counter').innerText : '0';
            if (type === 'like') {
                mainReactBtn.innerHTML = `<i class="fa-solid fa-thumbs-up text-primary custom-react-icon animate-pop"></i> <span class="main-btn-text ${textClass}">Reactions (<span id="main-total-counter">${total}</span>)</span>`;
            } else {
                const emojiMap = { funny: '😂', sad: '😢', wow: '😮', angry: '😡' };
                mainReactBtn.innerHTML = `${emojiMap[type]} <span class="main-btn-text ${textClass}">Reactions (<span id="main-total-counter">${total}</span>)</span>`;
            }
        }

        if (mainReactBtn && emojisPanel && triggerZone) {

            triggerZone.addEventListener('mouseenter', () => {
                clearTimeout(leaveTimeout);
                enterTimeout = setTimeout(() => {
                    emojisPanel.classList.add('show-panel');
                }, 500);
            });

            triggerZone.addEventListener('mouseleave', () => {
                clearTimeout(enterTimeout);
                leaveTimeout = setTimeout(() => {
                    emojisPanel.classList.remove('show-panel');
                }, 700);
            });

            mainReactBtn.addEventListener('touchstart', (e) => {
                isLongPress = false;
                clearTimeout(touchTimeout);

                touchTimeout = setTimeout(() => {
                    isLongPress = true;
                    emojisPanel.classList.add('show-panel');
                }, 500);
            }, { passive: true });

            mainReactBtn.addEventListener('touchend', (e) => {
                clearTimeout(touchTimeout);
                if (isLongPress) {
                    e.preventDefault();
                }
            });

            mainReactBtn.addEventListener('contextmenu', (e) => {
                e.preventDefault();
            });

            mainReactBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if (!currentUserId) return;
                if (isLongPress) return;

                const isCurrentlyActive = mainReactBtn.classList.contains('active-react');

                if (isCurrentlyActive) {
                    const selectedOpt = document.querySelector('.emoji-option-btn.selected');
                    const activeType = selectedOpt ? selectedOpt.dataset.type : 'like';
                    sendReactionRequest(activeType);
                } else {
                    sendReactionRequest('like');
                }
            });

            document.addEventListener('click', (e) => {
                if (!triggerZone.contains(e.target)) {
                    emojisPanel.classList.remove('show-panel');
                }
            });

            document.querySelectorAll('.emoji-option-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (!currentUserId) return;
                    const reactionType = btn.dataset.type;
                    sendReactionRequest(reactionType);
                });

                btn.addEventListener('touchend', (e) => {
                    e.stopPropagation();
                    if (!currentUserId) return;
                    const reactionType = btn.dataset.type;
                    sendReactionRequest(reactionType);
                });
            });
        }

        document.querySelector('.comments-list').addEventListener('submit', async function(e) {
            if (e.target.classList.contains('delete-comment-form')) {
                e.preventDefault();
                const form = e.target;
                try {
                    await fetch(form.action, { method: 'POST' });
                } catch (err) {
                    console.error(err);
                }
            }
        });

        const addCommentForm = document.querySelector('.add-comment-form');
        if (addCommentForm) {
            addCommentForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                const form = e.target;
                const textarea = form.querySelector('textarea');
                const formData = new URLSearchParams(new FormData(form));

                try {
                    textarea.value = '';
                    await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                    });
                } catch (err) {
                    console.error(err);
                }
            });
        }
    });
</script>

<%- include('partials/footer') %>